# Conexão com o PostgreSQL do CRM (pegue no EasyPanel → serviço crm-truckfort → Credenciais).
# Exemplo: postgres://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgres://postgres:SENHA@SEU_HOST:5432/crm
# Se o provedor exigir SSL, descomente:
# DATABASE_SSL=1
# Chave que o agente da ZAY usa para gravar no CRM (invente uma frase longa). Se vazio, libera no modo local.
CRM_API_KEY=
