# Worker do Executor — modelo. Copie para worker/.env e preencha. NÃO comitar o .env real.
EXEC_CRM_URL=http://localhost:3000
EXEC_WORKER_SECRET=defina-um-segredo-do-worker
EXEC_PROJETOS_RAIZ=C:\Users\herik\Documents\Zay
EXEC_PROJETOS_AUTORIZADOS=zay-crm,zay-app
EXEC_POLL_MS=5000
EXEC_TIMEOUT_SEG=600
EXEC_CLAUDE_CMD=claude
# Ajuste os flags de permissão conforme a versão do Claude Code (modo não-interativo e seguro):
EXEC_CLAUDE_ARGS=-p --permission-mode acceptEdits
